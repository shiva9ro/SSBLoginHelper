<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Android Keystoreの鍵はバックアップされないため、暗号文も除外する。 -->
        <exclude
            domain="sharedpref"
            path="encrypted_credentials.xml" />
        <exclude
            domain="sharedpref"
            path="automation_control.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="encrypted_credentials.xml" />
        <exclude
            domain="sharedpref"
            path="automation_control.xml" />
    </device-transfer>
</data-extraction-rules>
